{
  "name": "defencewire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "crawl": "vite-node --script crawler/ingest.ts",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "typecheck": "tsc --noEmit",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:crawler": "vite-node scripts/check-crawler.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "check:security": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run check:contracts && npm run check:crawler && npm test && npm run build && npm run check:budget && npm run check:security",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.4"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.13.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
