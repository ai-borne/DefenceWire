{
  "name": "defencewire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "crawl": "vite-node --script crawler/ingest.ts",
    "sitemap": "vite-node --script scripts/generate-sitemap.mjs",
    "llms": "vite-node --script scripts/generate-llms.mjs",
    "cache:purge": "vite-node --script scripts/purge-cache.mjs",
    "d1:migrate:local": "wrangler d1 execute defencewire-archive --local --file=d1/schema.sql",
    "d1:migrate:remote": "wrangler d1 execute defencewire-archive --remote --file=d1/schema.sql",
    "d1:size": "vite-node --script crawler/d1SizeCheck.ts",
    "backfill:cluster-json": "vite-node --script crawler/scripts/backfillClusterJsonToR2.ts",
    "suppliers:review": "node scripts/review-supplier-candidates.mjs",
    "typecheck": "tsc --noEmit",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:crawler": "vite-node scripts/check-crawler.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "check:security": "npm audit --audit-level=high",
    "check:css": "stylelint \"src/**/*.css\"",
    "check": "npm run typecheck && npm run check:contracts && npm run check:crawler && npm run check:css && npm test && npm run build && npm run check:budget && npm run check:security",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.13.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "stylelint": "^17.14.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wrangler": "^4.127.1"
  }
}
